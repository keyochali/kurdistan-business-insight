# Apify Configuration
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APIFY_USER_ID=your_apify_user_id

# Anthropic (Claude) API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database
DATABASE_URL=sqlite:///./data/newsletter.db

# Application
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# Pipeline Settings
DAILY_ARTICLE_COUNT=20
SCRAPE_HOUR=17
SCRAPE_MINUTE=0
TIMEZONE=Asia/Baghdad

# Optional: Unsplash API for fallback images
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
